#!/bin/sh

set -eu

DOTFILES=${DOTFILES:-"$HOME/.dotfiles"}
GLOBAL_IGNORE_FILE=$DOTFILES/.stow-global-ignore

requested_packages() {
  if [ -n "${STOW_FOLDERS:-}" ]; then
    printf '%s\n' "$STOW_FOLDERS" | tr ',[:space:]' '\n' | while IFS= read -r package; do
      [ -n "$package" ] && printf '%s\n' "$package"
    done
  else
    printf '%s\n' bin btop desktop zsh mise starship-zsh ghostty tmux hypr nvim opencode omarchy-user herdr misc
  fi
}

validate_packages() {
  requested_packages | while IFS= read -r package; do
    case $package in
      . | .. | -*)
        printf 'invalid Stow package name: %s\n' "$package" >&2
        exit 2
        ;;
      *[!A-Za-z0-9._-]*)
        printf 'invalid Stow package name: %s\n' "$package" >&2
        exit 2
        ;;
    esac

    if [ ! -d "$DOTFILES/$package" ]; then
      printf 'missing Stow package: %s\n' "$package" >&2
      exit 1
    fi
  done
}

prepare_shared_ancestors() {
  for relative in \
    .config \
    .local \
    .local/bin \
    .local/share \
    .local/share/icons \
    .local/share/icons/hicolor \
    .local/share/icons/hicolor/256x256 \
    .local/share/icons/hicolor/256x256/apps \
    .opencode
  do
    target=$HOME/$relative
    if [ -L "$target" ] || { [ -e "$target" ] && [ ! -d "$target" ]; }; then
      printf 'shared Stow ancestor must be a real directory: %s\n' "$target" >&2
      exit 1
    fi
    if [ ! -e "$target" ]; then
      mkdir -- "$target"
    fi
  done
}

stow_package() {
  package=$1
  set --

  while IFS= read -r pattern || [ -n "$pattern" ]; do
    case $pattern in
      '' | \#*) continue ;;
    esac
    set -- "$@" "--ignore=$pattern"
  done < "$GLOBAL_IGNORE_FILE"

  printf 'stowing %s\n' "$package"
  stow "$@" --dir "$DOTFILES" --target "$HOME" "$package"
}

if [ "${1:-}" = "--list-packages" ]; then
  requested_packages
  exit 0
fi

if [ "$#" -ne 0 ]; then
  printf 'usage: %s [--list-packages]\n' "$0" >&2
  exit 2
fi

if [ ! -r "$GLOBAL_IGNORE_FILE" ]; then
  printf 'missing shared Stow ignore list: %s\n' "$GLOBAL_IGNORE_FILE" >&2
  exit 1
fi

validate_packages
prepare_shared_ancestors

requested_packages | while IFS= read -r package; do
  stow_package "$package"
done
