{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 600
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "matjam.omawall",
          "primaryDisplay": "DP-2",
          "perDisplayConfig": true,
          "displayConfig": {
            "DP-2": {
              "folder": "/mnt/media/Wallpapers/anime_girls/landscape",
              "mode": "shuffle",
              "pinned": "",
              "recursive": true,
              "scaling": "zoom"
            },
            "HDMI-A-1": {
              "folder": "/mnt/media/Wallpapers/anime_girls/portrait",
              "mode": "shuffle",
              "pinned": "",
              "recursive": true,
              "scaling": "zoom"
            }
          },
          "shuffleOnWake": true,
          "intervalSec": 86400,
          "autoTheme": false
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "glafeara.wireguard"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.background"
  ],
  "cloneSourceRestores": [
    "matjam.omawall"
  ]
}
