#!/usr/bin/env bash

set -u

script=$(readlink -f -- "${BASH_SOURCE[0]}")
repo=$(readlink -f -- "$(dirname -- "$script")/../../..")
failures=0

fail() {
  printf 'FAIL: %s\n' "$*"
  ((failures += 1))
}

check_regular() {
  local path=$1
  if [[ -L $path ]]; then
    fail "$path must be a regular file, not a symlink"
  elif [[ ! -f $path ]]; then
    fail "$path is missing or is not a regular file"
  fi
}

check_directory() {
  local path=$1
  if [[ -L $path ]]; then
    fail "$path must be a real directory, not a symlink"
  elif [[ ! -d $path ]]; then
    fail "$path is missing or is not a directory"
  fi
}

check_file() {
  local path=$1 description=$2
  [[ -f $path ]] || fail "$description is missing: $path"
}

check_setting() {
  local path=$1 pattern=$2 description=$3
  if [[ ! -f $path ]]; then
    fail "$description cannot be checked; missing $path"
  elif ! grep -Eq -- "$pattern" "$path"; then
    fail "$description is not configured in $path"
  fi
}

check_baseline() {
  local path=$1 expected=$2
  local actual
  if [[ ! -f $path ]]; then
    fail "Omarchy baseline is missing: $path"
    return
  fi
  actual=$(sha256sum "$path")
  actual=${actual%% *}
  [[ $actual == "$expected" ]] || fail "Omarchy updated $path; review and merge its changes into the tracked override"
}

check_omarchy_overlays() {
  local ghostty_default=/usr/share/omarchy/config/ghostty/config
  local ghostty_tracked=$repo/ghostty/.config/ghostty/config
  local tmux_default=/usr/share/omarchy/config/tmux/tmux.conf
  local tmux_tracked=$repo/tmux/.config/tmux/tmux.conf

  if [[ ! -f $ghostty_default ]]; then
    fail "Omarchy Ghostty default is missing: $ghostty_default"
  elif ! diff -q <(awk '
    { print }
    /^gtk-toolbar-style = flat$/ {
      print ""
      print "# Shell"
      print "command = /usr/bin/zsh"
    }
  ' "$ghostty_default") "$ghostty_tracked" >/dev/null; then
    fail "$ghostty_tracked has drifted from the Omarchy default plus approved overrides"
  fi

  if [[ ! -f $tmux_default ]]; then
    fail "Omarchy tmux default is missing: $tmux_default"
  elif ! diff -q <(awk '
    { print }
    /^# General$/ { print "set -g default-shell /usr/bin/zsh" }
  ' "$tmux_default") "$tmux_tracked" >/dev/null; then
    fail "$tmux_tracked has drifted from the Omarchy default plus approved overrides"
  fi

  check_baseline /usr/share/omarchy/config/hypr/autostart.lua 907eddc68deabc3ecb5c3337bf76ebb90a7603052e203ac35e50235348a5b65d
  check_baseline /usr/share/omarchy/config/hypr/hyprland.lua 39974ad22f150e7b47f407a808ed60299dbec53a80f7908425e5b153ace3fe8d
  check_baseline /usr/share/omarchy/config/hypr/input.lua 1c3904e31df667d5bee09ddad3744365f1341e8a6833855d92872789dbe667f7
  check_baseline /usr/share/omarchy/config/hypr/monitors.lua 20d293b118ec43ce871132acae619f1bacab43988ea94aeb5d4988b72e683225
}

printf 'Stow links\n'
while IFS= read -r package; do
  package_root=$repo/$package
  while IFS= read -r -d '' source; do
    relative=${source#"$package_root"/}
    target=$HOME/$relative
    if [[ ! -e $target && ! -L $target ]]; then
      fail "missing link: $target -> $source"
    elif [[ ! -L $target ]]; then
      fail "regular file replaces expected link: $target"
    elif [[ $(readlink -f -- "$target") != "$source" ]]; then
      fail "unexpected link: $target -> $(readlink -- "$target") (expected $source)"
    fi
  done < <(find "$package_root" \( -type f -o -type l \) -print0)
done < <(DOTFILES="$repo" "$repo/stow_config" --list-packages)

printf 'System invariants\n'
check_regular "$HOME/.bashrc"
check_regular "$HOME/.bash_profile"
check_regular "$HOME/.config/mise/config.toml"
check_regular "$HOME/.config/hypr/.luarc.json"
check_regular "$HOME/.config/hypr/bindings.lua"
check_regular "$HOME/.config/hypr/looknfeel.lua"
check_regular "$HOME/.config/hypr/hyprsunset.conf"
check_regular "$HOME/.config/hypr/xdph.conf"
check_regular "$HOME/.config/omarchy/branding/about.txt"
check_regular "$HOME/.config/omarchy/shell.json"
check_regular "$HOME/.config/omarchy/shell.toml"
check_regular "$HOME/.config/opencode/opencode.json"
check_regular "$HOME/.config/opencode/tui.json"
check_directory "$HOME/.config/omarchy"
check_directory "$HOME/.config/omarchy/branding"
check_directory "$HOME/.config/opencode"
check_directory "$HOME/.agents/skills"

account_shell=$(getent passwd "$(id -un)" | awk -F: '{print $7}')
account_shell=$(readlink -f -- "$account_shell" 2>/dev/null)
[[ $account_shell == /usr/bin/bash ]] || fail "account shell is ${account_shell:-unknown}; expected Bash"

for retired in "$HOME/.tmux.conf" "$HOME/.zsh_profile" "$HOME/.p10k.zsh"; do
  if [[ -L $retired ]] && [[ $(readlink -f -m -- "$retired") == "$repo"/* ]]; then
    fail "retired Stow link remains: $retired"
  fi
done

check_setting "$HOME/.config/ghostty/config" \
  '^[[:space:]]*command[[:space:]]*=[[:space:]]*/usr/bin/zsh([[:space:]]|$)' \
  'Ghostty command /usr/bin/zsh'
check_setting "$HOME/.config/tmux/tmux.conf" \
  "^[[:space:]]*set(-option)?[[:space:]]+-g[[:space:]]+default-shell[[:space:]]+['\"]?/usr/bin/zsh['\"]?([[:space:]]|$)" \
  'tmux default-shell /usr/bin/zsh'
check_setting "$repo/opencode/.config/opencode/opencode.jsonc" \
  '"autoupdate"[[:space:]]*:[[:space:]]*false' \
  'OpenCode automatic updates disabled'
check_setting "$repo/opencode/.config/opencode/opencode.jsonc" \
  '"shell"[[:space:]]*:[[:space:]]*"/usr/bin/bash"' \
  'OpenCode Bash tool shell'
check_setting "$repo/opencode/.config/opencode/opencode.jsonc" \
  '"share"[[:space:]]*:[[:space:]]*"disabled"' \
  'OpenCode sharing disabled'
check_omarchy_overlays

printf 'Zsh dependencies\n'
check_file "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/oh-my-zsh/oh-my-zsh.sh" 'Oh My Zsh'
check_file "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh" 'fzf-tab'
check_file '/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh' 'packaged zsh-autosuggestions plugin'
check_file '/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh' 'packaged zsh-syntax-highlighting plugin'
check_file '/usr/share/fzf/completion.zsh' 'packaged fzf Zsh completion'
check_file '/usr/share/fzf/key-bindings.zsh' 'packaged fzf Zsh key bindings'

printf 'Tracked shell configuration\n'
starship_config=$repo/starship-zsh/.config/starship-zsh.toml
check_file "$starship_config" 'tracked Starship Zsh configuration'
color_number='(1[6-9]|[2-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])'
if [[ -f $starship_config ]] && {
  grep -Eiq "['\"][^'\"]*#[[:xdigit:]]{3,8}[^'\"]*['\"]" "$starship_config" ||
  grep -Eiq "^[[:space:]]*[^#]*(style|color|foreground|background)[[:space:]]*=.*(^|[^0-9])$color_number([^0-9]|$)" "$starship_config" ||
  grep -Eiq "^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=[[:space:]]*['\"]$color_number['\"]" "$starship_config"
}; then
  fail "$starship_config contains a fixed hex or numeric 256-color style"
fi

while IFS= read -r -d '' startup; do
  if grep -Eq 'zoxide[[:space:]]+init[[:space:]]+zsh' "$startup"; then
    fail "forbidden zoxide initialization found in $startup"
  fi
done < <(find "$repo/zsh" -type f \( -name '.zsh*' -o -name '*.zsh' \) -print0)

printf 'Required commands\n'
for command_name in bash stow zsh starship ghostty tmux mise opencode git fzf sops npx; do
  command -v "$command_name" >/dev/null 2>&1 || fail "required command is unavailable: $command_name"
done

if ((failures)); then
  printf '\n%d problem(s) found.\n' "$failures"
  exit 1
fi

printf '\nAll dotfile checks passed.\n'
