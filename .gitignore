.env
.ansible/

# Omarchy local plugin checkouts and their Git metadata.
/omarchy-user/.config/omarchy/plugins/

# Downloaded dependency payloads (keep manifests and dependency lockfiles).
/opencode/.config/opencode/**/node_modules/
/mise/.config/mise/**/node_modules/

# OpenCode local credentials.
/opencode/.config/opencode/service.json

# Generated pointers; retain their external targets outside Git.
/btop/.config/btop/themes/current.theme
/omarchy-user/.config/omarchy/backgrounds/omawall/current.png

# Herdr local runtime data; config.toml and declarative integration data track.
/herdr/.config/herdr/.plugins.lock
/herdr/.config/herdr/release-notes.json
/herdr/.config/herdr/session.json
/herdr/.config/herdr/session-snapshots/
/herdr/.config/herdr/*.log
/herdr/.config/herdr/*.sock
/herdr/.config/herdr/herdr.sock.agent

# Disposable launcher cache and currently observed local backups.
/desktop/.local/share/applications/mimeinfo.cache
/hypr/.config/hypr/*.bak
/hypr/.config/hypr/*.bak.*
/hypr/.config/hypr/*.before-*
/misc/.config/voxtype/*.bak
/opencode/.config/opencode/opencode.json.tui-migration.bak
