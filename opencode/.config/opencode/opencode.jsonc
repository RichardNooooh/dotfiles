{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "shell": "/usr/bin/bash",
  "share": "disabled",
  "plugins": [
    "file:///home/rnoh/.local/share/mise/installs/npm-oc-codex-multi-auth/latest/node_modules/oc-codex-multi-auth/dist"
  ],
  "mcp": {
    "servers": {
      "mcp_search": {
        "type": "remote",
        "url": "https://mcp-search.citadel.lab.answerisnoh.dev/mcp",
        "disabled": false,
        "oauth": false
      },
      "mcp_crawl": {
        "type": "local",
        "disabled": false,
        "command": [
          "npx",
          "-y",
          "mcp-remote@0.1.38",
          "https://mcp-crawl.citadel.lab.answerisnoh.dev/mcp/sse",
          "--transport",
          "sse-only",
          "--header",
          "Authorization: Bearer ${CRAWL4AI_API_TOKEN}"
        ]
      }
    }
  },
  // OpenCode 2.0.28 requires this key; top-level policies are ignored.
  "experimental": {
    "policies": [
    // Hard blocks override permission asks and saved approvals.
    {"action": "tool.use", "resource": "read:*.sops.yml", "effect": "deny"},
    {"action": "tool.use", "resource": "read:*.sops.yaml", "effect": "deny"},
    {"action": "tool.use", "resource": "read:*.sops.json", "effect": "deny"},
    {"action": "tool.use", "resource": "read:/home/rnoh/.local/share/homelab-secrets/**", "effect": "deny"},
    {"action": "tool.use", "resource": "read:/home/rnoh/.config/sops/**", "effect": "deny"},
    {"action": "tool.use", "resource": "read:/home/rnoh/.config/age/**", "effect": "deny"},
    {"action": "tool.use", "resource": "edit:*.sops.yml", "effect": "deny"},
    {"action": "tool.use", "resource": "edit:*.sops.yaml", "effect": "deny"},
    {"action": "tool.use", "resource": "edit:*.sops.json", "effect": "deny"},
    {"action": "tool.use", "resource": "edit:/home/rnoh/.local/share/homelab-secrets/**", "effect": "deny"},
    {"action": "tool.use", "resource": "edit:/home/rnoh/.config/sops/**", "effect": "deny"},
    {"action": "tool.use", "resource": "edit:/home/rnoh/.config/age/**", "effect": "deny"},
    {"action": "tool.use", "resource": "external_directory:/home/rnoh/.local/share/homelab-secrets/**", "effect": "deny"},
    {"action": "tool.use", "resource": "external_directory:/home/rnoh/.config/sops/**", "effect": "deny"},
    {"action": "tool.use", "resource": "external_directory:/home/rnoh/.config/age/**", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*sops*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:age *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:* age *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*age-keygen*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*HOMELAB_SECRETS_DIR*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*homelab-secrets*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*.sops.*", "effect": "deny"},
    {"action": "integration.use", "resource": "plugin:/home/rnoh/.config/opencode/plugins/herdr-agent-state.js", "effect": "deny"},
    ]
  },
  "permissions": [
    // Default approval, followed by established global exceptions.
    {"action": "*", "resource": "*", "effect": "ask"},
    {"action": "codex_*", "resource": "*", "effect": "deny"},
    {"action": "exa_*", "resource": "*", "effect": "allow"},
    {"action": "mcp_search_*", "resource": "*", "effect": "allow"},
    {"action": "mcp_crawl_*", "resource": "*", "effect": "allow"},
    // Read access and environment-file approval behavior.
    {"action": "read", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "*.env", "effect": "ask"},
    {"action": "read", "resource": "*.env.*", "effect": "ask"},
    {"action": "read", "resource": "*.env.example", "effect": "allow"},
    // Local discovery tools.
    {"action": "glob", "resource": "*", "effect": "allow"},
    {"action": "grep", "resource": "*", "effect": "allow"},
    // Skills and web access.
    {"action": "skill", "resource": "*", "effect": "allow"},
    {"action": "webfetch", "resource": "*", "effect": "allow"},
    {"action": "question", "resource": "*", "effect": "allow"},
    // Editing defaults and environment-file approval behavior.
    {"action": "edit", "resource": "*", "effect": "allow"},
    {"action": "edit", "resource": "*.env", "effect": "ask"},
    {"action": "edit", "resource": "*.env.*", "effect": "ask"},
    {"action": "edit", "resource": "*.env.example", "effect": "ask"},
    // External-directory access.
    {"action": "external_directory", "resource": "*", "effect": "ask"},
    {"action": "external_directory", "resource": "/tmp/opencode/**", "effect": "allow"},
    {"action": "external_directory", "resource": "~/.agents/**", "effect": "allow"},
    {"action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow"},
    {"action": "external_directory", "resource": "~/.dotfiles/opencode/**", "effect": "allow"},
    // Shell auto-approval allowlist, followed by overrides.
    {"action": "shell", "resource": "*", "effect": "ask"},
    {"action": "shell", "resource": "git annotate *", "effect": "allow"},
    {"action": "shell", "resource": "git blame *", "effect": "allow"},
    {"action": "shell", "resource": "git cat-file *", "effect": "allow"},
    {"action": "shell", "resource": "git check-attr *", "effect": "allow"},
    {"action": "shell", "resource": "git check-ignore *", "effect": "allow"},
    {"action": "shell", "resource": "git check-mailmap *", "effect": "allow"},
    {"action": "shell", "resource": "git check-ref-format *", "effect": "allow"},
    {"action": "shell", "resource": "git cherry *", "effect": "allow"},
    {"action": "shell", "resource": "git config get *", "effect": "allow"},
    {"action": "shell", "resource": "git config list *", "effect": "allow"},
    {"action": "shell", "resource": "git config --get *", "effect": "allow"},
    {"action": "shell", "resource": "git config --list *", "effect": "allow"},
    {"action": "shell", "resource": "git count-objects *", "effect": "allow"},
    {"action": "shell", "resource": "git describe *", "effect": "allow"},
    {"action": "shell", "resource": "git diff *", "effect": "allow"},
    {"action": "shell", "resource": "git for-each-ref *", "effect": "allow"},
    {"action": "shell", "resource": "git grep *", "effect": "allow"},
    {"action": "shell", "resource": "git last-modified *", "effect": "allow"},
    {"action": "shell", "resource": "git log *", "effect": "allow"},
    {"action": "shell", "resource": "git ls-files *", "effect": "allow"},
    {"action": "shell", "resource": "git ls-remote *", "effect": "allow"},
    {"action": "shell", "resource": "git ls-tree *", "effect": "allow"},
    {"action": "shell", "resource": "git merge-base *", "effect": "allow"},
    {"action": "shell", "resource": "git name-rev *", "effect": "allow"},
    {"action": "shell", "resource": "git range-diff *", "effect": "allow"},
    {"action": "shell", "resource": "git reflog show *", "effect": "allow"},
    {"action": "shell", "resource": "git repo *", "effect": "allow"},
    {"action": "shell", "resource": "git rev-list *", "effect": "allow"},
    {"action": "shell", "resource": "git rev-parse *", "effect": "allow"},
    {"action": "shell", "resource": "git shortlog *", "effect": "allow"},
    {"action": "shell", "resource": "git show *", "effect": "allow"},
    {"action": "shell", "resource": "git status *", "effect": "allow"},
    {"action": "shell", "resource": "git var *", "effect": "allow"},
    {"action": "shell", "resource": "git verify-pack *", "effect": "allow"},
    {"action": "shell", "resource": "git whatchanged *", "effect": "allow"},
    {"action": "shell", "resource": "git branch", "effect": "allow"},
    {"action": "shell", "resource": "git branch --contains*", "effect": "allow"},
    {"action": "shell", "resource": "git branch --format*", "effect": "allow"},
    {"action": "shell", "resource": "git branch --list*", "effect": "allow"},
    {"action": "shell", "resource": "git branch --merged*", "effect": "allow"},
    {"action": "shell", "resource": "git branch --no-contains*", "effect": "allow"},
    {"action": "shell", "resource": "git branch --no-merged*", "effect": "allow"},
    {"action": "shell", "resource": "git branch --show-current*", "effect": "allow"},
    {"action": "shell", "resource": "git notes get-ref*", "effect": "allow"},
    {"action": "shell", "resource": "git notes list*", "effect": "allow"},
    {"action": "shell", "resource": "git notes show*", "effect": "allow"},
    {"action": "shell", "resource": "git remote", "effect": "allow"},
    {"action": "shell", "resource": "git remote --verbose*", "effect": "allow"},
    {"action": "shell", "resource": "git remote -v*", "effect": "allow"},
    {"action": "shell", "resource": "git remote get-url*", "effect": "allow"},
    {"action": "shell", "resource": "git remote show*", "effect": "allow"},
    {"action": "shell", "resource": "git stash list *", "effect": "allow"},
    {"action": "shell", "resource": "git submodule status *", "effect": "allow"},
    {"action": "shell", "resource": "git tag", "effect": "allow"},
    {"action": "shell", "resource": "git tag --contains*", "effect": "allow"},
    {"action": "shell", "resource": "git tag --format*", "effect": "allow"},
    {"action": "shell", "resource": "git tag --list*", "effect": "allow"},
    {"action": "shell", "resource": "git tag --merged*", "effect": "allow"},
    {"action": "shell", "resource": "git tag --no-contains*", "effect": "allow"},
    {"action": "shell", "resource": "git tag --no-merged*", "effect": "allow"},
    {"action": "shell", "resource": "git tag --points-at*", "effect": "allow"},
    {"action": "shell", "resource": "git worktree list *", "effect": "allow"},
    {"action": "shell", "resource": "gh agent-task list *", "effect": "allow"},
    {"action": "shell", "resource": "gh agent-task view *", "effect": "allow"},
    {"action": "shell", "resource": "gh cache list *", "effect": "allow"},
    {"action": "shell", "resource": "gh codespace list *", "effect": "allow"},
    {"action": "shell", "resource": "gh codespace logs *", "effect": "allow"},
    {"action": "shell", "resource": "gh codespace view *", "effect": "allow"},
    {"action": "shell", "resource": "gh discussion list *", "effect": "allow"},
    {"action": "shell", "resource": "gh discussion view *", "effect": "allow"},
    {"action": "shell", "resource": "gh gist list *", "effect": "allow"},
    {"action": "shell", "resource": "gh gist view *", "effect": "allow"},
    {"action": "shell", "resource": "gh gpg-key list *", "effect": "allow"},
    {"action": "shell", "resource": "gh issue list *", "effect": "allow"},
    {"action": "shell", "resource": "gh issue status *", "effect": "allow"},
    {"action": "shell", "resource": "gh issue view *", "effect": "allow"},
    {"action": "shell", "resource": "gh label list *", "effect": "allow"},
    {"action": "shell", "resource": "gh org list *", "effect": "allow"},
    {"action": "shell", "resource": "gh pr checks *", "effect": "allow"},
    {"action": "shell", "resource": "gh pr diff *", "effect": "allow"},
    {"action": "shell", "resource": "gh pr list *", "effect": "allow"},
    {"action": "shell", "resource": "gh pr status *", "effect": "allow"},
    {"action": "shell", "resource": "gh pr view *", "effect": "allow"},
    {"action": "shell", "resource": "gh project field-list *", "effect": "allow"},
    {"action": "shell", "resource": "gh project item-list *", "effect": "allow"},
    {"action": "shell", "resource": "gh project list *", "effect": "allow"},
    {"action": "shell", "resource": "gh project view *", "effect": "allow"},
    {"action": "shell", "resource": "gh release list *", "effect": "allow"},
    {"action": "shell", "resource": "gh release view *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo autolink list *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo autolink view *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo deploy-key list *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo gitignore list *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo gitignore view *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo license list *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo license view *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo list *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo read-dir *", "effect": "allow"},
    {"action": "shell", "resource": "gh repo view *", "effect": "allow"},
    {"action": "shell", "resource": "gh ruleset check *", "effect": "allow"},
    {"action": "shell", "resource": "gh ruleset list *", "effect": "allow"},
    {"action": "shell", "resource": "gh ruleset view *", "effect": "allow"},
    {"action": "shell", "resource": "gh run list *", "effect": "allow"},
    {"action": "shell", "resource": "gh run view *", "effect": "allow"},
    {"action": "shell", "resource": "gh run watch *", "effect": "allow"},
    {"action": "shell", "resource": "gh search code *", "effect": "allow"},
    {"action": "shell", "resource": "gh search commits *", "effect": "allow"},
    {"action": "shell", "resource": "gh search issues *", "effect": "allow"},
    {"action": "shell", "resource": "gh search prs *", "effect": "allow"},
    {"action": "shell", "resource": "gh search repos *", "effect": "allow"},
    {"action": "shell", "resource": "gh secret list *", "effect": "allow"},
    {"action": "shell", "resource": "gh skill preview *", "effect": "allow"},
    {"action": "shell", "resource": "gh skill search *", "effect": "allow"},
    {"action": "shell", "resource": "gh ssh-key list *", "effect": "allow"},
    {"action": "shell", "resource": "gh status *", "effect": "allow"},
    {"action": "shell", "resource": "gh workflow list *", "effect": "allow"},
    {"action": "shell", "resource": "gh workflow view *", "effect": "allow"},
    {"action": "shell", "resource": "ls *", "effect": "allow"},
    {"action": "shell", "resource": "command -v *", "effect": "allow"},
    {"action": "shell", "resource": "rg *", "effect": "allow"},
    {"action": "shell", "resource": "pwd", "effect": "allow"},
    {"action": "shell", "resource": "whoami", "effect": "allow"},
    {"action": "shell", "resource": "id *", "effect": "allow"},
    {"action": "shell", "resource": "uname *", "effect": "allow"},
    {"action": "shell", "resource": "date", "effect": "allow"},
    {"action": "shell", "resource": "stat *", "effect": "allow"},
    {"action": "shell", "resource": "file *", "effect": "allow"},
    {"action": "shell", "resource": "realpath *", "effect": "allow"},
    {"action": "shell", "resource": "readlink *", "effect": "allow"},
    {"action": "shell", "resource": "rg *--pre*", "effect": "ask"},
    {"action": "shell", "resource": "gh *--web*", "effect": "ask"},
    {"action": "shell", "resource": "gh * -w*", "effect": "ask"},
    {"action": "shell", "resource": "git cat-file *--filters*", "effect": "ask"},
    {"action": "shell", "resource": "git grep *--ext-grep*", "effect": "ask"},
    {"action": "shell", "resource": "git grep *-O*", "effect": "ask"},
    {"action": "shell", "resource": "git ls-remote *--upload-pack*", "effect": "ask"},
    {"action": "shell", "resource": "git ls-remote * -u *", "effect": "ask"},
    {"action": "shell", "resource": "git * --ext-diff*", "effect": "ask"},
    {"action": "shell", "resource": "git * --open-files-in-pager*", "effect": "ask"},
    {"action": "shell", "resource": "git * --output *", "effect": "ask"},
    {"action": "shell", "resource": "git * --output=*", "effect": "ask"},
    {"action": "shell", "resource": "git * --textconv*", "effect": "ask"},
    {"action": "shell", "resource": "*>*", "effect": "ask"},
    {"action": "shell", "resource": "*<*", "effect": "ask"},
    {"action": "shell", "resource": "*.env*", "effect": "ask"},
    // Repository configuration may request approval for OpenCode invocations.
    {"action": "shell", "resource": "opencode *", "effect": "deny"},
    {"action": "shell", "resource": "*/opencode *", "effect": "deny"},
    // Only the named custom subagents may be launched.
    {"action": "subagent", "resource": "*", "effect": "deny"},
    {"action": "subagent", "resource": "work", "effect": "allow"},
    {"action": "subagent", "resource": "research", "effect": "allow"},
    {"action": "subagent", "resource": "explore", "effect": "allow"},
    {"action": "subagent", "resource": "review", "effect": "allow"},
    // Named MCP restrictions override wildcard grants.
    {"action": "mcp_search_searxng_search_suggestions", "resource": "*", "effect": "deny"},
    {"action": "mcp_search_searxng_instance_info", "resource": "*", "effect": "deny"},
    {"action": "mcp_crawl_md", "resource": "*", "effect": "deny"},
    {"action": "mcp_crawl_html", "resource": "*", "effect": "deny"},
    {"action": "mcp_crawl_screenshot", "resource": "*", "effect": "deny"},
    {"action": "mcp_crawl_pdf", "resource": "*", "effect": "deny"},
    {"action": "mcp_crawl_execute_js", "resource": "*", "effect": "deny"},
    {"action": "mcp_crawl_crawl", "resource": "*", "effect": "deny"},
    {"action": "mcp_crawl_ask", "resource": "*", "effect": "deny"},
    // Disable built-in web search in favor of configured MCP search.
    {"action": "websearch", "resource": "*", "effect": "deny"}
  ],
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 12000
  },
  "compaction": {
    "auto": true
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "variants": [
            {
              "id": "reasoning-medium-verbosity-low",
              "settings": {
                "reasoningEffort": "medium",
                "textVerbosity": "low"
              }
            }
          ]
        },
        "gpt-6.1-sol": {
          "variants": [
            {
              "id": "reasoning-high-verbosity-low",
              "settings": {
                "reasoningEffort": "high",
                "textVerbosity": "low"
              }
            },
            {
              "id": "reasoning-medium-verbosity-low",
              "settings": {
                "reasoningEffort": "medium",
                "textVerbosity": "low"
              }
            }
          ]
        },
        "gpt-5.6-luna": {
          "variants": [
            {
              "id": "reasoning-medium-verbosity-low",
              "settings": {
                "reasoningEffort": "medium",
                "textVerbosity": "low"
              }
            }
          ]
        }
      }
    }
  },
  "agents": {
    "history": {
      "disabled": true,
      "description": "Search, inspect, and summarize previous OpenCode sessions and related documentation.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra#reasoning-medium-verbosity-low",
      "system": "Use conversation history, local read-only inspection, and external research to answer questions. Do not modify files or execute shell commands.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "research",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "code-review",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "grilling",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "domain-modeling",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "research",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        }
      ]
    },
    "plan": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "~/.opencode/plan/*",
          "effect": "allow"
        }
      ]
    },
    "explore": {
      "description": "Use to locate code, trace behavior, summarize basic findings, and perform other simple read-only work. Do not plan or make suggestions.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna#reasoning-medium-verbosity-low",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "research",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "code-review",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "grilling",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "domain-modeling",
          "effect": "deny"
        }
      ]
    }
  }
}
