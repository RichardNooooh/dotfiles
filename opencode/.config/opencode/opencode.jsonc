{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": false,
  "shell": "/usr/bin/bash",

  "plugin": [
    "opencode-history-search",
    "oc-codex-multi-auth"
  ],

  "mcp": {
    "mcp_search": {
      "type": "remote",
      "url": "https://mcp-search.citadel.lab.answerisnoh.dev/mcp",
      "enabled": true,
      "oauth": false
    },
    "mcp_crawl": {
      "type": "remote",
      "url": "https://mcp-crawl.citadel.lab.answerisnoh.dev/mcp/sse",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CRAWL4AI_API_TOKEN}"
      }
    }
  },

  "tools": {
    "mcp_search_searxng_search_suggestions": false,
    "mcp_search_searxng_instance_info": false,
    "mcp_search_web_url_read": false,
    "mcp_crawl_html": false,
    "mcp_crawl_screenshot": false,
    "mcp_crawl_pdf": false,
    "mcp_crawl_execute_js": false,
    "mcp_crawl_crawl": false,
    "mcp_crawl_ask": false
  },

  // "mcp": {
  //   "exa": {
  //     "type": "local",
  //     "command": [
  //       "sops",
  //       "exec-env",
  //       "--same-process",
  //       "{env:HOME}/.local/share/homelab-secrets/agents/exa-search.sops.yaml",
  //       "npx -y exa-mcp-server"
  //     ],
  //     "enabled": true
  //   }
  // },

  "share": "disabled",
  // "enabled_providers": ["openai"],

  "permission": {
    "*": "ask",

    "codex-*": "deny",
    "exa_*": "allow",
    "history-search": "deny",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.sops.yml": "deny",
      "*.sops.yaml": "deny",
      "*.sops.json": "deny",
      "~/.local/share/homelab-secrets/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/age/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "batch": "allow",
    "edit": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "ask",
      "*.sops.yml": "deny",
      "*.sops.yaml": "deny",
      "*.sops.json": "deny",
      "~/.local/share/homelab-secrets/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/age/**": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "~/.agents/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.dotfiles/opencode/**": "allow",
      "~/.local/share/homelab-secrets/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/age/**": "deny"
    },
    "bash": {
      "*": "ask",

      // Canonical Git inspection commands. Mixed-purpose commands are
      // constrained to forms that do not update refs or the working tree.
      "git annotate": "allow",
      "git annotate *": "allow",
      "git blame": "allow",
      "git blame *": "allow",
      "git cat-file": "allow",
      "git cat-file *": "allow",
      "git check-attr": "allow",
      "git check-attr *": "allow",
      "git check-ignore": "allow",
      "git check-ignore *": "allow",
      "git check-mailmap": "allow",
      "git check-mailmap *": "allow",
      "git check-ref-format": "allow",
      "git check-ref-format *": "allow",
      "git cherry": "allow",
      "git cherry *": "allow",
      "git config get": "allow",
      "git config get *": "allow",
      "git config list": "allow",
      "git config list *": "allow",
      "git config --get": "allow",
      "git config --get *": "allow",
      "git config --list": "allow",
      "git config --list *": "allow",
      "git count-objects": "allow",
      "git count-objects *": "allow",
      "git describe": "allow",
      "git describe *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git for-each-ref": "allow",
      "git for-each-ref *": "allow",
      "git grep": "allow",
      "git grep *": "allow",
      "git last-modified": "allow",
      "git last-modified *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-remote": "allow",
      "git ls-remote *": "allow",
      "git ls-tree": "allow",
      "git ls-tree *": "allow",
      "git merge-base": "allow",
      "git merge-base *": "allow",
      "git name-rev": "allow",
      "git name-rev *": "allow",
      "git range-diff": "allow",
      "git range-diff *": "allow",
      "git reflog show": "allow",
      "git reflog show *": "allow",
      "git repo": "allow",
      "git repo *": "allow",
      "git rev-list": "allow",
      "git rev-list *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git shortlog": "allow",
      "git shortlog *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git var": "allow",
      "git var *": "allow",
      "git verify-pack": "allow",
      "git verify-pack *": "allow",
      "git whatchanged": "allow",
      "git whatchanged *": "allow",
      "git branch": "allow",
      "git branch --contains*": "allow",
      "git branch --format*": "allow",
      "git branch --list*": "allow",
      "git branch --merged*": "allow",
      "git branch --no-contains*": "allow",
      "git branch --no-merged*": "allow",
      "git branch --show-current*": "allow",
      "git notes get-ref*": "allow",
      "git notes list*": "allow",
      "git notes show*": "allow",
      "git remote": "allow",
      "git remote --verbose*": "allow",
      "git remote -v*": "allow",
      "git remote get-url*": "allow",
      "git remote show*": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",
      "git submodule status": "allow",
      "git submodule status *": "allow",
      "git tag": "allow",
      "git tag --contains*": "allow",
      "git tag --format*": "allow",
      "git tag --list*": "allow",
      "git tag --merged*": "allow",
      "git tag --no-contains*": "allow",
      "git tag --no-merged*": "allow",
      "git tag --points-at*": "allow",
      "git worktree list": "allow",
      "git worktree list *": "allow",

      // GitHub queries that read remote state without downloading files,
      // launching a browser, exposing tokens, or invoking arbitrary APIs.
      "gh agent-task list": "allow",
      "gh agent-task list *": "allow",
      "gh agent-task view": "allow",
      "gh agent-task view *": "allow",
      "gh cache list": "allow",
      "gh cache list *": "allow",
      "gh codespace list": "allow",
      "gh codespace list *": "allow",
      "gh codespace logs": "allow",
      "gh codespace logs *": "allow",
      "gh codespace view": "allow",
      "gh codespace view *": "allow",
      "gh discussion list": "allow",
      "gh discussion list *": "allow",
      "gh discussion view": "allow",
      "gh discussion view *": "allow",
      "gh gist list": "allow",
      "gh gist list *": "allow",
      "gh gist view": "allow",
      "gh gist view *": "allow",
      "gh gpg-key list": "allow",
      "gh gpg-key list *": "allow",
      "gh issue list": "allow",
      "gh issue list *": "allow",
      "gh issue status": "allow",
      "gh issue status *": "allow",
      "gh issue view": "allow",
      "gh issue view *": "allow",
      "gh label list": "allow",
      "gh label list *": "allow",
      "gh org list": "allow",
      "gh org list *": "allow",
      "gh pr checks": "allow",
      "gh pr checks *": "allow",
      "gh pr diff": "allow",
      "gh pr diff *": "allow",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "gh pr status": "allow",
      "gh pr status *": "allow",
      "gh pr view": "allow",
      "gh pr view *": "allow",
      "gh project field-list": "allow",
      "gh project field-list *": "allow",
      "gh project item-list": "allow",
      "gh project item-list *": "allow",
      "gh project list": "allow",
      "gh project list *": "allow",
      "gh project view": "allow",
      "gh project view *": "allow",
      "gh release list": "allow",
      "gh release list *": "allow",
      "gh release view": "allow",
      "gh release view *": "allow",
      "gh repo autolink list": "allow",
      "gh repo autolink list *": "allow",
      "gh repo autolink view": "allow",
      "gh repo autolink view *": "allow",
      "gh repo deploy-key list": "allow",
      "gh repo deploy-key list *": "allow",
      "gh repo gitignore list": "allow",
      "gh repo gitignore list *": "allow",
      "gh repo gitignore view": "allow",
      "gh repo gitignore view *": "allow",
      "gh repo license list": "allow",
      "gh repo license list *": "allow",
      "gh repo license view": "allow",
      "gh repo license view *": "allow",
      "gh repo list": "allow",
      "gh repo list *": "allow",
      "gh repo read-dir": "allow",
      "gh repo read-dir *": "allow",
      "gh repo view": "allow",
      "gh repo view *": "allow",
      "gh ruleset check": "allow",
      "gh ruleset check *": "allow",
      "gh ruleset list": "allow",
      "gh ruleset list *": "allow",
      "gh ruleset view": "allow",
      "gh ruleset view *": "allow",
      "gh run list": "allow",
      "gh run list *": "allow",
      "gh run view": "allow",
      "gh run view *": "allow",
      "gh run watch": "allow",
      "gh run watch *": "allow",
      "gh search code": "allow",
      "gh search code *": "allow",
      "gh search commits": "allow",
      "gh search commits *": "allow",
      "gh search issues": "allow",
      "gh search issues *": "allow",
      "gh search prs": "allow",
      "gh search prs *": "allow",
      "gh search repos": "allow",
      "gh search repos *": "allow",
      "gh secret list": "allow",
      "gh secret list *": "allow",
      "gh skill preview": "allow",
      "gh skill preview *": "allow",
      "gh skill search": "allow",
      "gh skill search *": "allow",
      "gh ssh-key list": "allow",
      "gh ssh-key list *": "allow",
      "gh status": "allow",
      "gh status *": "allow",
      "gh workflow list": "allow",
      "gh workflow list *": "allow",
      "gh workflow view": "allow",
      "gh workflow view *": "allow",

      "ls *": "allow",
      "command -v *": "allow",
      "rg *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "id *": "allow",
      "uname *": "allow",
      "date": "allow",
      "stat *": "allow",
      "file *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "rg *--pre*": "ask",
      "gh *--web*": "ask",
      "gh * -w*": "ask",
      "git cat-file *--filters*": "ask",
      "git grep *--ext-grep*": "ask",
      "git grep *-O*": "ask",
      "git ls-remote *--upload-pack*": "ask",
      "git ls-remote * -u *": "ask",
      "git * --ext-diff*": "ask",
      "git * --open-files-in-pager*": "ask",
      "git * --output *": "ask",
      "git * --output=*": "ask",
      "git * --textconv*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*sops*": "deny",
      "age": "deny",
      "age *": "deny",
      "* age": "deny",
      "* age *": "deny",
      "*age-keygen*": "deny",
      "*HOMELAB_SECRETS_DIR*": "deny",
      "*homelab-secrets*": "deny",
      "*.sops.*": "deny",
      "*.env*": "ask"
    },
    "task": {
      "*": "deny",
      "worker": "allow",
      "researcher": "allow",
      "explorer": "allow",
      "reviewer": "allow"
    }
  },

  "compaction": {
    "auto": false,
    "prune": false
  },

  "experimental": {
    "batch_tool": true
  },

  "agent": {
    // Primary agents own interaction, orchestration, and artifact workflows.
    // Custom roles receive bounded briefs rather than owning those workflows.
    "history": {
      "description": "Search, inspect, and summarize previous OpenCode sessions and related documentation.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "prompt": "Use conversation history, local read-only inspection, and external research to answer questions. Do not modify files or execute shell commands.",

      "permission": {
        "edit": "deny",
        "bash": "deny",
        "history-search": "allow",
        "skill": {
          "research": "deny",
          "code-review": "deny",
          "grilling": "deny",
          "domain-modeling": "deny"
        },
        "task": {
          "*": "deny",
          "researcher": "allow",
          "explorer": "allow"
        }
      }
    },

    "worker": {
      "description": "Use for implementation, refactoring, tests, validation, and other non-specialized work.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "permission": {
          "question": "deny",
          "skill": {
            "research": "deny",
            "code-review": "deny",
            "grilling": "deny",
            "domain-modeling": "deny"
          }
      }
    },

    "researcher": {
      "description": "Use for complex external documentation, dependency, and architectural research, along with complex independent planning.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "steps": 30,
      "reasoningEffort": "high",
      "textVerbosity": "low",

      "prompt": "Perform one bounded investigation. Before investigating, verify that the brief satisfies the Research Delegation contract in the global AGENTS.md. If it does not, return a scope objection and propose independently researchable briefs without beginning broad research. Investigate only the accepted brief. Prefer official documentation, source code, specifications, and first-party material; use secondary sources for concrete practitioner experience or when primary evidence is absent. While websearch uses the free anonymous Exa service, begin with at most two focused queries and inspect the best three to five authoritative sources. Search further only to resolve conflicts or material gaps, and never issue more than two searches concurrently. Attempt each query at most three times: the initial search, one retry after other useful work, then fetch any known authoritative URLs before one final search. Stop immediately when a 429 indicates the daily limit. This Exa-specific policy applies only to the current free websearch tool, not the planned SearXNG and Firecrawl tooling. Stop when the required claims are supported, conflicts and gaps are identified, and further reading is unlikely to change the answer. Return only a concise answer, claim-linked evidence, conflicts or unknowns, and gaps; do not include a reading diary. If the step limit interrupts the investigation, return the best partial result and explicit gaps. Do not create research files or other artifacts.",

      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "question": "deny",
        "skill": {
          "research": "deny",
          "code-review": "deny",
          "grilling": "deny",
          "domain-modeling": "deny"
        }
      }
    },

    "reviewer": {
      "description": "Use only for substantial changes where an independent review could find meaningful defects; do not use for trivial edits.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "high",
      "textVerbosity": "low",

      "permission": {
        "edit": "deny",
        "task": "deny",
        "question": "deny",
        "skill": {
          "research": "deny",
          "code-review": "deny",
          "grilling": "deny",
          "domain-modeling": "deny"
        }
      }
    },

    "explorer": {
      "description": "Use to locate code, trace behavior, summarize basic findings, and perform other simple read-only work. Do not plan or make suggestions.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "question": "deny",
        "skill": {
          "research": "deny",
          "code-review": "deny",
          "grilling": "deny",
          "domain-modeling": "deny"
        }
      }
    },

    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
