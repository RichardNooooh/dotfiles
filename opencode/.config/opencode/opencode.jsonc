{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": false,
  "shell": "/usr/bin/bash",

  "plugin": [
    "opencode-history-search"
  ],

  // "mcp": {
  //   "exa": {
  //     "type": "local",
  //     "command": [
  //       "sops",
  //       "exec-env",
  //       "--same-process",
  //       "{env:HOME}/.local/share/homelab-secrets/agents/exa-search.sops.yaml",
  //       "npx -y exa-mcp-server"
  //     ],
  //     "enabled": true
  //   }
  // },

  "share": "disabled",
  // "enabled_providers": ["openai"],

  "permission": {
    "*": "ask",

    "exa_*": "allow",
    "history-search": "deny",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.sops.yml": "deny",
      "*.sops.yaml": "deny",
      "*.sops.json": "deny",
      "~/.local/share/homelab-secrets/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/age/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "edit": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "ask",
      "*.sops.yml": "deny",
      "*.sops.yaml": "deny",
      "*.sops.json": "deny",
      "~/.local/share/homelab-secrets/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/age/**": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "~/.agents/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.dotfiles/opencode/**": "allow",
      "~/.local/share/homelab-secrets/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/age/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "ls *": "allow",
      "command -v *": "allow",
      "rg *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "id *": "allow",
      "uname *": "allow",
      "date": "allow",
      "stat *": "allow",
      "file *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "rg *--pre*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*sops*": "deny",
      "age": "deny",
      "age *": "deny",
      "* age": "deny",
      "* age *": "deny",
      "*age-keygen*": "deny",
      "*HOMELAB_SECRETS_DIR*": "deny",
      "*homelab-secrets*": "deny",
      "*.sops.*": "deny",
      "*.env*": "ask"
    },
    "task": {
      "*": "deny",
      "worker": "allow",
      "researcher": "allow",
      "explorer": "allow",
      "reviewer": "allow"
    }
  },

  "compaction": {
    "auto": false,
    "prune": false
  },

  "agent": {
    // Primary agents own interaction, orchestration, and artifact workflows.
    // Custom roles receive bounded briefs rather than owning those workflows.
    "history": {
      "description": "Search, inspect, and summarize previous OpenCode sessions and related documentation.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "prompt": "Use conversation history, local read-only inspection, and external research to answer questions. Do not modify files or execute shell commands.",

      "permission": {
        "edit": "deny",
        "bash": "deny",
        "history-search": "allow",
        "skill": {
          "research": "deny",
          "code-review": "deny",
          "grilling": "deny",
          "domain-modeling": "deny"
        },
        "task": {
          "*": "deny",
          "researcher": "allow",
          "explorer": "allow"
        }
      }
    },

    "worker": {
      "description": "Use for implementation, refactoring, tests, validation, and other non-specialized work.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "permission": {
          "question": "deny",
          "skill": {
            "research": "deny",
            "code-review": "deny",
            "grilling": "deny",
            "domain-modeling": "deny"
          }
      }
    },

    "researcher": {
      "description": "Use for complex external documentation, dependency, and architectural research, along with complex independent planning.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "steps": 12,
      "reasoningEffort": "high",
      "textVerbosity": "low",

      "prompt": "Perform one bounded investigation. Before investigating, verify that the brief satisfies the Research Delegation contract in the global AGENTS.md. If it does not, return a scope objection and propose independently researchable briefs without beginning broad research. Investigate only the accepted brief. Prefer official documentation, source code, specifications, and first-party material; use secondary sources for concrete practitioner experience or when primary evidence is absent. While websearch uses the free anonymous Exa service, begin with at most two focused queries and inspect the best three to five authoritative sources. Search further only to resolve conflicts or material gaps, and never issue more than two searches concurrently. Attempt each query at most three times: the initial search, one retry after other useful work, then fetch any known authoritative URLs before one final search. Stop immediately when a 429 indicates the daily limit. This Exa-specific policy applies only to the current free websearch tool, not the planned SearXNG and Firecrawl tooling. Stop when the required claims are supported, conflicts and gaps are identified, and further reading is unlikely to change the answer. Return only a concise answer, claim-linked evidence, conflicts or unknowns, and gaps; do not include a reading diary. If the step limit interrupts the investigation, return the best partial result and explicit gaps. Do not create research files or other artifacts.",

      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "question": "deny",
        "skill": {
          "research": "deny",
          "code-review": "deny",
          "grilling": "deny",
          "domain-modeling": "deny"
        }
      }
    },

    "reviewer": {
      "description": "Use only for substantial changes where an independent review could find meaningful defects; do not use for trivial edits.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "high",
      "textVerbosity": "low",

      "permission": {
        "edit": "deny",
        "task": "deny",
        "question": "deny",
        "skill": {
          "research": "deny",
          "code-review": "deny",
          "grilling": "deny",
          "domain-modeling": "deny"
        }
      }
    },

    "explorer": {
      "description": "Use to locate code, trace behavior, summarize basic findings, and perform other simple read-only work. Do not plan or make suggestions.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "question": "deny",
        "skill": {
          "research": "deny",
          "code-review": "deny",
          "grilling": "deny",
          "domain-modeling": "deny"
        }
      }
    },

    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
