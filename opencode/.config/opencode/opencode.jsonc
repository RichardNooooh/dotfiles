{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "opencode-history-search"
  ],

  "share": "disabled",
  "enabled_providers": ["openai"],

  "permission": {
    // The plugin is installed, but unavailable to ordinary agents.
    "history-search": "deny",

    // Subagents available to primary agents by default.
    "task": {
      "*": "deny",
      "worker": "allow",
      "researcher": "allow",
      "explorer": "allow",
      "reviewer": "allow"
    }
  },

  "compaction": {
    "auto": false,
    "prune": false
  },

  "agent": {
    "history": {
      "description": "Search, inspect, and summarize previous OpenCode sessions and related documentation.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "prompt": "Use conversation history, local read-only inspection, and external research to answer questions. Do not modify files or execute shell commands.",

      "permission": {
        "*": "deny",

        // Local read-only inspection.
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",

        // OpenCode session history.
        "history-search": "allow",

        // External research.
        "webfetch": "allow",
        "websearch": "allow",

        // Only these subagents may be delegated to.
        "task": {
          "*": "deny",
          "researcher": "allow",
          "explorer": "allow"
        }
      }
    },

    "worker": {
      "description": "Use for implementation, refactoring, tests, validation, and other non-specialized work.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "permission": {
        "*": "deny",

        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",

        "bash": {
          "*": "allow",
          "git commit*": "ask",
          "git push*": "ask",
          "git reset --hard*": "deny",
          "git clean*": "ask",
          "rm -rf*": "ask",
          "sudo*": "deny"
        },

        "lsp": "allow",
        "skill": "allow"
      }
    },

    "researcher": {
      "description": "Use for complex external documentation, dependency, and architectural research, along with complex independent planning. Do not re-use same researcher subagent; start a new research subagent each time.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",

      "permission": {
        "*": "deny",

        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",

        "bash": "ask",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },

    "reviewer": {
      "description": "Use only for substantial changes where an independent review could find meaningful defects; do not use for trivial edits.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "high",
      "textVerbosity": "low",

      "permission": {
        "*": "deny",

        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",

        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git show*": "allow"
        }
      }
    },

    "explorer": {
      "description": "Use to locate code, trace behavior, summarize basic findings, and perform other simple read-only work. Do not plan or make suggestions.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "permission": {
        "*": "deny",

        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow"
      }
    }
  }
}
