{
  "$schema": "https://opencode.ai/config.json",

  // Optional privacy preference.
  "share": "disabled",

  // Optional: hide providers you do not intend to use.
  "enabled_providers": ["openai"],

  // Only expose these two subagents to primary agents.
  "permission": {
    "task": {
      "*": "deny",
      "worker": "allow",
      "explorer": "allow"
    }
  },

  // Helps control long-session tool-output accumulation.
  "compaction": {
    "auto": true,
    "prune": true
  },

  "agent": {
    "worker": {
      "description": "Use for implementation, refactoring, tests, and validation.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low",

      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "lsp": "allow",
        "skill": "allow",

        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },

    "explorer": {
      "description": "Use to locate code, trace behavior, and summarize findings.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low",

      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "deny",
        "lsp": "allow",
        "skill": "allow",

        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
